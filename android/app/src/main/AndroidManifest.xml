<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Android 11+ (API 30+) package-visibility rules mean apps can't detect
      whether another app (like Venmo) is installed unless declared here.
      Braintree's own SDK changelog has an entry for exactly this issue
      ("Add Venmo to queries element in AndroidManifest.xml (fixes issue in
      Android 11 not properly detecting if Venmo app is installed)") — the
      venmo module's AAR should merge this automatically via manifest
      merger, but declaring it explicitly here too is a safe, redundant
      belt-and-suspenders fix in case that merge doesn't happen for any
      reason (e.g. an older resolved venmo version).

      CONFIRMED SEPARATE REQUIREMENT (from Braintree's own SDK team, via
      internal #service-pw-venmo, 8/2026): the native Android/iOS SDK
      hardcodes a check for the exact installed package "com.venmo" before
      it will attempt App Switch. There is no sandbox-specific Venmo app
      that will ever trigger this — BT's mobile SDK does not support Venmo
      App Switch against any sandbox Venmo app, by design, regardless of
      manifest config or SDK flags. Testing App Switch requires:
        - the REAL, production Venmo app (package "com.venmo") installed
        - logged into a REAL personal Venmo account (not a special test
          account from qa.venmo.com or similar)
      If those two things aren't true on the test device, falling back to
      the browser flow is correct, expected behavior — not a bug in this
      project's code. (This is a different system from the enableVenmoSandbox
      / merchant-whitelisting process, which applies only to the web JS SDK's
      braintree.venmo.create() button, not this native Android integration.)
    -->
    <queries>
        <package android:name="com.venmo" />
    </queries>

    <!--
      DEMO NOTE:
      - We are calling a local HTTP server (http://localhost:3000) via adb reverse.
      - Cleartext is allowed ONLY for demo/dev; remove this for production.
    -->
    <application

        android:usesCleartextTraffic="true"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.WoodSBXBraintree">

        <!-- ============================================================
             LAUNCHER
             ============================================================ -->
        <activity
            android:name=".PickerActivity"
            android:exported="true"
            android:label="Braintree Demo Suite">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ============================================================
             GROUP 1: ONE TIME PAYMENT
             ============================================================ -->
        <activity
            android:name=".onetime.CardActivity"
            android:exported="false"
            android:label="One Time Payment — Card"
            android:windowSoftInputMode="adjustResize" />

        <!--
          PayPal (one-time): own App Link path + fallback scheme so the
          return-to-app deep link routes here specifically (see
          shared/ReturnUrls.kt — oneTimePayPalAppLink / oneTimePayPalFallbackScheme).
        -->
        <activity
            android:name=".onetime.PayPalActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:label="One Time Payment — PayPal">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${applicationId}.braintree.onetimepaypal" />
            </intent-filter>
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="mwoodpp.github.io"
                    android:pathPrefix="/braintree/onetime-paypal" />
            </intent-filter>
        </activity>

        <!-- Venmo (one-time): own App Link path + fallback scheme. -->
        <activity
            android:name=".onetime.VenmoActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:label="One Time Payment — Venmo">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${applicationId}.braintree.onetimevenmo" />
            </intent-filter>
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="mwoodpp.github.io"
                    android:pathPrefix="/braintree/onetime-venmo" />
            </intent-filter>
        </activity>

        <!--
          Google Pay (one-time): returns via Activity Result, not a deep
          link, so no intent-filter is needed here at all.
        -->
        <activity
            android:name=".onetime.GooglePayActivity"
            android:exported="false"
            android:label="One Time Payment — Google Pay" />

        <!-- ============================================================
             GROUP 2: CHECKOUT WITH VAULT
             ============================================================ -->
        <activity
            android:name=".checkoutwithvault.CardVaultActivity"
            android:exported="false"
            android:label="Checkout with Vault — Card"
            android:windowSoftInputMode="adjustResize" />

        <!-- PayPal + Vault: own App Link path + fallback scheme. -->
        <activity
            android:name=".checkoutwithvault.PayPalVaultActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:label="Checkout with Vault — PayPal"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${applicationId}.braintree.checkoutvaultpaypal" />
            </intent-filter>
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="mwoodpp.github.io"
                    android:pathPrefix="/braintree/checkoutvault-paypal" />
            </intent-filter>
        </activity>

        <!-- ============================================================
             GROUP 3: VAULT
             ============================================================ -->
        <activity
            android:name=".vault.StoreCardActivity"
            android:exported="false"
            android:label="Vault — Store: Card"
            android:windowSoftInputMode="adjustResize" />

        <!-- Store: PayPal: own App Link path + fallback scheme. -->
        <activity
            android:name=".vault.StorePayPalActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:label="Vault — Store: PayPal"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${applicationId}.braintree.storepaypal" />
            </intent-filter>
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="mwoodpp.github.io"
                    android:pathPrefix="/braintree/store-paypal" />
            </intent-filter>
        </activity>

        <!-- Charge Vaulted: no Braintree SDK client at all, no intent-filter needed. -->
        <activity
            android:name=".vault.ChargeVaultedActivity"
            android:exported="false"
            android:label="Vault — Charge Vaulted"
            android:windowSoftInputMode="adjustResize" />

        <!-- Store: Venmo: own App Link path + fallback scheme. -->
        <activity
            android:name=".vault.StoreVenmoActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:label="Vault — Store: Venmo">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${applicationId}.braintree.storevenmo" />
            </intent-filter>
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="mwoodpp.github.io"
                    android:pathPrefix="/braintree/store-venmo" />
            </intent-filter>
        </activity>

        <!-- Store: Google Pay: returns via Activity Result, no intent-filter needed. -->
        <activity
            android:name=".vault.StoreGooglePayActivity"
            android:exported="false"
            android:label="Vault — Store: Google Pay" />

    </application>

</manifest>
