<?xml version="1.0" encoding="utf-8"?>
<!--
  Reusable diagnostics log panel. Include at the bottom of any screen with:
      <include layout="@layout/partial_log_panel" />
  Then in the Activity:
      diagnostics.bind(findViewById(R.id.logText))
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="160dp"
    android:layout_marginTop="16dp"
    android:background="@drawable/bg_log_panel"
    android:padding="12dp">

    <TextView
        android:id="@+id/logText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:text="Ready."
        android:textColor="@color/log_text"
        android:textIsSelectable="true"
        android:textSize="11sp" />

</ScrollView>
